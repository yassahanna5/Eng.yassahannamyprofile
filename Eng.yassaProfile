    <!-- Bootstrap JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
    
    <!-- Firebase & Custom JS -->
    <script>
        // Firebase configuration for yassaprofile
        const firebaseConfig = {
            apiKey: "AIzaSyCT1oq5m43Vtx0uRk4V116BVawmND_YhBY",
            authDomain: "yassaprofile.firebaseapp.com",
            projectId: "yassaprofile",
            storageBucket: "yassaprofile.firebasestorage.app",
            messagingSenderId: "153752906886",
            appId: "1:153752906886:web:2ae615e64c13d11a4c7507"
        };

        // Initialize Firebase
        firebase.initializeApp(firebaseConfig);
        const db = firebase.firestore();

        // Default data
        const defaultProjects = [
            {
                id: "project1",
                title: "SecureAuth System",
                description: "A multi-factor authentication system with biometric verification and behavioral analysis for enhanced security.",
                category: "web",
                icon: "fas fa-shield-alt",
                tags: ["React", "Node.js", "Biometrics"]
            },
            {
                id: "project2",
                title: "Vulnerability Scanner",
                description: "An automated tool for detecting security vulnerabilities in web applications and network infrastructure.",
                category: "security",
                icon: "fas fa-search",
                tags: ["Python", "Security", "Automation"]
            }
        ];

        const defaultAbout = {
            name: "Eng.yassa hanna",
            content: "I'm a passionate full-stack developer and cybersecurity specialist with over 7 years of experience building secure, scalable web applications and protecting digital assets from modern threats.",
            email: "yassahanna5@gmail.com",
            location: "Minia, Egypt"
        };

        const defaultContact = {
            email: "yassahanna5@gmail.com",
            phone: "+20 123 456 7890",
            location: "Minia, Egypt"
        };

        // Theme Toggle Functionality
        function toggleTheme() {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            const themeToggle = document.getElementById('themeToggle');
            
            if (currentTheme === 'light') {
                document.documentElement.setAttribute('data-theme', 'dark');
                themeToggle.innerHTML = '<i class="fas fa-moon"></i>';
                localStorage.setItem('theme', 'dark');
            } else {
                document.documentElement.setAttribute('data-theme', 'light');
                themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
                localStorage.setItem('theme', 'light');
            }
        }

        // Initialize theme from localStorage
        function initTheme() {
            const savedTheme = localStorage.getItem('theme') || 'dark';
            const themeToggle = document.getElementById('themeToggle');
            
            document.documentElement.setAttribute('data-theme', savedTheme);
            
            if (savedTheme === 'light') {
                themeToggle.innerHTML = '<i class="fas fa-sun"></i>';
            } else {
                themeToggle.innerHTML = '<i class="fas fa-moon"></i>';
            }
        }

        // Show login panel
        function showLogin() {
            document.getElementById('login-panel').style.display = 'flex';
        }

        // Hide login panel
        function hideLogin() {
            document.getElementById('login-panel').style.display = 'none';
            document.getElementById('loginAlert').classList.add('d-none');
            document.getElementById('adminLoginForm').reset();
        }

        // Show admin panel
        function showAdminPanel() {
            document.getElementById('login-panel').style.display = 'none';
            document.getElementById('admin-panel').style.display = 'block';
            document.getElementById('main-website').style.display = 'none';
        }

        // Show main website
        function showMainWebsite() {
            document.getElementById('admin-panel').style.display = 'none';
            document.getElementById('login-panel').style.display = 'none';
            document.getElementById('main-website').style.display = 'block';
        }

        // Initialize data
        async function initializeData() {
            try {
                // Check if about data exists
                const aboutDoc = await db.collection('portfolio').doc('about').get();
                if (!aboutDoc.exists) {
                    await db.collection('portfolio').doc('about').set(defaultAbout);
                }

                // Check if contact data exists
                const contactDoc = await db.collection('portfolio').doc('contact').get();
                if (!contactDoc.exists) {
                    await db.collection('portfolio').doc('contact').set(defaultContact);
                }

                // Check if projects exist
                const projectsSnapshot = await db.collection('projects').get();
                if (projectsSnapshot.empty) {
                    // Add default projects
                    for (const project of defaultProjects) {
                        await db.collection('projects').doc(project.id).set(project);
                    }
                }

                console.log('Data initialized successfully');
                loadContent();
            } catch (error) {
                console.error('Error initializing data:', error);
            }
        }

        // Load content from Firestore
        function loadContent() {
            // Load projects
            db.collection('projects').onSnapshot((snapshot) => {
                const projects = [];
                snapshot.forEach((doc) => {
                    projects.push(doc.data());
                });
                updateProjectsGrid(projects);
                updateProjectsTable(projects);
            });

            // Load about content
            db.collection('portfolio').doc('about').onSnapshot((doc) => {
                const about = doc.data();
                if (about) {
                    updateAboutSection(about);
                    updateAboutForm(about);
                }
            });

            // Load contact info
            db.collection('portfolio').doc('contact').onSnapshot((doc) => {
                const contact = doc.data();
                if (contact) {
                    updateContactForm(contact);
                }
            });

            // Load messages
            db.collection('messages').orderBy('timestamp', 'desc').onSnapshot((snapshot) => {
                const messages = [];
                snapshot.forEach((doc) => {
                    messages.push({id: doc.id, ...doc.data()});
                });
                updateMessagesTable(messages);
                updateMessagesCount(messages.length);
            });
        }

        // Update projects grid in main website
        function updateProjectsGrid(projects) {
            const projectsGrid = document.getElementById('projects-grid');
            if (!projectsGrid) return;

            projectsGrid.innerHTML = '';
            
            projects.forEach(project => {
                const projectCard = `
                    <div class="col-lg-4 col-md-6 mb-4" data-category="${project.category}">
                        <div class="project-card">
                            <div class="project-img">
                                <i class="${project.icon}" style="font-size: 4rem; color: rgba(255,255,255,0.2);"></i>
                            </div>
                            <div class="project-content">
                                <h4>${project.title}</h4>
                                <p>${project.description}</p>
                                <div class="project-tags">
                                    ${project.tags.map(tag => `<span class="project-tag">${tag}</span>`).join('')}
                                </div>
                            </div>
                        </div>
                    </div>
                `;
                projectsGrid.innerHTML += projectCard;
            });

            // Re-attach filter functionality
            attachProjectFilters();
        }

        // Update projects table in admin panel
        function updateProjectsTable(projects) {
            const tableBody = document.getElementById('projectsTableBody');
            const projectsCount = document.getElementById('projectsCount');
            
            if (!tableBody) return;
            
            projectsCount.textContent = projects.length;
            tableBody.innerHTML = '';
            
            projects.forEach(project => {
                const row = `
                    <tr>
                        <td>${project.title}</td>
                        <td><span class="badge-cyber">${project.category}</span></td>
                        <td>${project.tags.map(tag => `<span class="badge-cyber">${tag}</span>`).join(' ')}</td>
                        <td>
                            <button class="action-btn edit" onclick="editProject('${project.id}')">
                                <i class="fas fa-edit"></i>
                            </button>
                            <button class="action-btn delete" onclick="deleteProject('${project.id}')">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tableBody.innerHTML += row;
            });
        }

        // Update messages table in admin panel
        function updateMessagesTable(messages) {
            const tableBody = document.getElementById('messagesTableBody');
            if (!tableBody) return;
            
            tableBody.innerHTML = '';
            
            messages.forEach(message => {
                const date = message.timestamp ? new Date(message.timestamp.seconds * 1000).toLocaleDateString() : 'N/A';
                const row = `
                    <tr>
                        <td>${message.name}</td>
                        <td>${message.email}</td>
                        <td>${message.subject}</td>
                        <td>${message.message.substring(0, 50)}${message.message.length > 50 ? '...' : ''}</td>
                        <td>${date}</td>
                        <td>
                            <button class="action-btn edit" onclick="viewMessage('${message.id}')" title="View Message">
                                <i class="fas fa-eye"></i>
                            </button>
                            <button class="action-btn delete" onclick="deleteMessage('${message.id}')" title="Delete Message">
                                <i class="fas fa-trash"></i>
                            </button>
                        </td>
                    </tr>
                `;
                tableBody.innerHTML += row;
            });
        }

        // Update messages count
        function updateMessagesCount(count) {
            const messagesCount = document.getElementById('messagesCount');
            if (messagesCount) {
                messagesCount.textContent = count;
            }
        }

        // Update about section in main website
        function updateAboutSection(about) {
            if (about.name) {
                document.getElementById('aboutName').textContent = about.name;
                document.getElementById('aboutNameInfo').textContent = about.name;
            }
            
            if (about.content) {
                document.getElementById('aboutContent').textContent = about.content;
            }

            if (about.email) {
                document.getElementById('aboutEmail').textContent = about.email;
            }

            if (about.location) {
                document.getElementById('aboutLocation').textContent = about.location;
            }
        }

        // Update about form in admin panel
        function updateAboutForm(about) {
            if (about) {
                document.getElementById('adminAboutName').value = about.name || '';
                document.getElementById('adminAboutContent').value = about.content || '';
                document.getElementById('adminAboutEmail').value = about.email || '';
                document.getElementById('adminAboutLocation').value = about.location || '';
            }
        }

        // Update contact form in admin panel
        function updateContactForm(contact) {
            if (contact) {
                document.getElementById('adminContactEmail').value = contact.email || '';
                document.getElementById('adminContactPhone').value = contact.phone || '';
                document.getElementById('adminContactLocation').value = contact.location || '';
            }
        }

        // Add new project
        async function addProject() {
            const title = document.getElementById('projectTitle').value;
            const description = document.getElementById('projectDescription').value;
            const category = document.getElementById('projectCategory').value;
            const icon = document.getElementById('projectIcon').value;
            const tags = document.getElementById('projectTags').value.split(',').map(tag => tag.trim());
            
            if (title && description && category && icon) {
                try {
                    const newProjectId = 'project' + Date.now();
                    const newProject = {
                        id: newProjectId,
                        title,
                        description,
                        category,
                        icon,
                        tags
                    };
                    
                    await db.collection('projects').doc(newProjectId).set(newProject);
                    
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addProjectModal'));
                    modal.hide();
                    document.getElementById('addProjectForm').reset();
                    showAlert('Project added successfully!');
                } catch (error) {
                    alert('Error adding project: ' + error.message);
                }
            } else {
                alert('Please fill all required fields');
            }
        }

        // Delete project
        async function deleteProject(projectId) {
            if (confirm('Are you sure you want to delete this project?')) {
                try {
                    await db.collection('projects').doc(projectId).delete();
                    showAlert('Project deleted successfully!');
                } catch (error) {
                    alert('Error deleting project: ' + error.message);
                }
            }
        }

        // Edit project
        async function editProject(projectId) {
            try {
                const projectDoc = await db.collection('projects').doc(projectId).get();
                const project = projectDoc.data();
                
                if (project) {
                    document.getElementById('projectTitle').value = project.title;
                    document.getElementById('projectDescription').value = project.description;
                    document.getElementById('projectCategory').value = project.category;
                    document.getElementById('projectIcon').value = project.icon;
                    document.getElementById('projectTags').value = project.tags.join(', ');
                    
                    const modal = new bootstrap.Modal(document.getElementById('addProjectModal'));
                    document.getElementById('addProjectModalLabel').textContent = 'Edit Project';
                    
                    const submitBtn = document.querySelector('#addProjectModal .btn-cyber-primary');
                    submitBtn.textContent = 'Update Project';
                    submitBtn.onclick = function() { updateProject(projectId); };
                    
                    modal.show();
                }
            } catch (error) {
                alert('Error loading project: ' + error.message);
            }
        }

        // Update project
        async function updateProject(projectId) {
            const title = document.getElementById('projectTitle').value;
            const description = document.getElementById('projectDescription').value;
            const category = document.getElementById('projectCategory').value;
            const icon = document.getElementById('projectIcon').value;
            const tags = document.getElementById('projectTags').value.split(',').map(tag => tag.trim());
            
            if (title && description && category && icon) {
                try {
                    const updatedProject = {
                        title,
                        description,
                        category,
                        icon,
                        tags
                    };
                    
                    await db.collection('projects').doc(projectId).update(updatedProject);
                    
                    const modal = bootstrap.Modal.getInstance(document.getElementById('addProjectModal'));
                    modal.hide();
                    showAlert('Project updated successfully!');
                    resetProjectModal();
                } catch (error) {
                    alert('Error updating project: ' + error.message);
                }
            } else {
                alert('Please fill all required fields');
            }
        }

        // Reset project modal
        function resetProjectModal() {
            document.getElementById('addProjectForm').reset();
            document.getElementById('addProjectModalLabel').textContent = 'Add New Project';
            const submitBtn = document.querySelector('#addProjectModal .btn-cyber-primary');
            submitBtn.textContent = 'Add Project';
            submitBtn.onclick = function() { addProject(); };
        }

        // View message details
        async function viewMessage(messageId) {
            try {
                const messageDoc = await db.collection('messages').doc(messageId).get();
                const message = messageDoc.data();
                
                if (message) {
                    const date = message.timestamp ? new Date(message.timestamp.seconds * 1000).toLocaleString() : 'N/A';
                    alert(`Message Details:\n\nName: ${message.name}\nEmail: ${message.email}\nSubject: ${message.subject}\nMessage: ${message.message}\nDate: ${date}`);
                }
            } catch (error) {
                alert('Error loading message: ' + error.message);
            }
        }

        // Delete message
        async function deleteMessage(messageId) {
            if (confirm('Are you sure you want to delete this message?')) {
                try {
                    await db.collection('messages').doc(messageId).delete();
                    showAlert('Message deleted successfully!');
                } catch (error) {
                    alert('Error deleting message: ' + error.message);
                }
            }
        }

        // About form submission
        document.getElementById('aboutForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const aboutData = {
                name: document.getElementById('adminAboutName').value,
                content: document.getElementById('adminAboutContent').value,
                email: document.getElementById('adminAboutEmail').value,
                location: document.getElementById('adminAboutLocation').value
            };
            
            try {
                await db.collection('portfolio').doc('about').set(aboutData);
                showAlert('About section updated successfully!');
            } catch (error) {
                alert('Error updating about section: ' + error.message);
            }
        });

        // Contact form submission
        document.getElementById('contactAdminForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const contactData = {
                email: document.getElementById('adminContactEmail').value,
                phone: document.getElementById('adminContactPhone').value,
                location: document.getElementById('adminContactLocation').value
            };
            
            try {
                await db.collection('portfolio').doc('contact').set(contactData);
                showAlert('Contact information updated successfully!');
            } catch (error) {
                alert('Error updating contact information: ' + error.message);
            }
        });

        // Contact form submission (main website)
        document.getElementById('contactForm').addEventListener('submit', async function(e) {
            e.preventDefault();
            
            const name = document.getElementById('name').value;
            const email = document.getElementById('email').value;
            const subject = document.getElementById('subject').value;
            const message = document.getElementById('message').value;
            
            if (name && email && subject && message) {
                try {
                    const messageData = {
                        name,
                        email,
                        subject,
                        message,
                        timestamp: firebase.firestore.FieldValue.serverTimestamp()
                    };
                    
                    await db.collection('messages').add(messageData);
                    
                    alert('Thank you for your message! I will get back to you soon.');
                    document.getElementById('contactForm').reset();
                } catch (error) {
                    alert('Error sending message: ' + error.message);
                }
            } else {
                alert('Please fill all required fields');
            }
        });

        // Show alert
        function showAlert(message) {
            const alert = document.getElementById('updateAlert');
            const alertMessage = document.getElementById('alertMessage');
            
            alertMessage.textContent = message;
            alert.style.display = 'block';
            
            setTimeout(() => {
                alert.style.display = 'none';
            }, 3000);
        }

        // Logout
        function logout() {
            if (confirm('Are you sure you want to logout?')) {
                showMainWebsite();
            }
        }

        // Admin Login Form Submission
        document.getElementById('adminLoginForm').addEventListener('submit', function(e) {
            e.preventDefault();
            
            const username = document.getElementById('username').value;
            const password = document.getElementById('password').value;
            const alertDiv = document.getElementById('loginAlert');
            const alertMessage = document.getElementById('alertMessage');
            
            // Simple validation for demo purposes
            if (username === 'admin' && password === 'admin123') {
                showAdminPanel();
            } else {
                alertMessage.textContent = 'Invalid login credentials. Please try again.';
                alertDiv.classList.remove('d-none');
                document.getElementById('password').value = '';
            }
        });

        // Attach project filters
        function attachProjectFilters() {
            const filterButtons = document.querySelectorAll('[data-filter]');
            const projectItems = document.querySelectorAll('#projects-grid > div');

            filterButtons.forEach(button => {
                button.addEventListener('click', function() {
                    filterButtons.forEach(btn => btn.classList.remove('active'));
                    this.classList.add('active');
                    
                    const filterValue = this.getAttribute('data-filter');
                    
                    projectItems.forEach(item => {
                        if (filterValue === 'all' || item.getAttribute('data-category') === filterValue) {
                            item.style.display = 'block';
                        } else {
                            item.style.display = 'none';
                        }
                    });
                });
            });
        }

        // Typing Effect
        document.addEventListener('DOMContentLoaded', function() {
            const typingText = document.getElementById('typing-text');
            const texts = [
                "Building secure digital solutions for the future.",
                "Protecting systems from modern cyber threats.",
                "Developing robust and scalable applications.",
                "Specializing in cybersecurity and full-stack development."
            ];
            let textIndex = 0;
            let charIndex = 0;
            let isDeleting = false;
            let typingSpeed = 100;

            function type() {
                const currentText = texts[textIndex];
                
                if (isDeleting) {
                    typingText.textContent = currentText.substring(0, charIndex - 1);
                    charIndex--;
                    typingSpeed = 50;
                } else {
                    typingText.textContent = currentText.substring(0, charIndex + 1);
                    charIndex++;
                    typingSpeed = 100;
                }

                if (!isDeleting && charIndex === currentText.length) {
                    isDeleting = true;
                    typingSpeed = 1000;
                } else if (isDeleting && charIndex === 0) {
                    isDeleting = false;
                    textIndex = (textIndex + 1) % texts.length;
                    typingSpeed = 500;
                }

                setTimeout(type, typingSpeed);
            }

            setTimeout(type, 1000);

            // Matrix Background
            const canvas = document.getElementById('matrixCanvas');
            const ctx = canvas.getContext('2d');
            
            canvas.width = window.innerWidth;
            canvas.height = window.innerHeight;
            
            const chars = "01";
            const charArray = chars.split("");
            const font_size = 14;
            const columns = canvas.width / font_size;
            const drops = [];
            
            for (let x = 0; x < columns; x++) {
                drops[x] = Math.floor(Math.random() * canvas.height / font_size);
            }
            
            function drawMatrix() {
                ctx.fillStyle = "rgba(10, 10, 10, 0.04)";
                ctx.fillRect(0, 0, canvas.width, canvas.height);
                
                ctx.fillStyle = "#0f0";
                ctx.font = font_size + "px 'JetBrains Mono', monospace";
                
                for (let i = 0; i < drops.length; i++) {
                    const text = charArray[Math.floor(Math.random() * charArray.length)];
                    ctx.fillText(text, i * font_size, drops[i] * font_size);
                    
                    if (drops[i] * font_size > canvas.height && Math.random() > 0.975) {
                        drops[i] = 0;
                    }
                    
                    drops[i]++;
                }
            }
            
            window.addEventListener('resize', function() {
                canvas.width = window.innerWidth;
                canvas.height = window.innerHeight;
            });
            
            setInterval(drawMatrix, 35);

            // Initialize theme
            initTheme();
            
            // Initialize Firebase data
            initializeData();
        });
    </script>
</body>
</html> 
